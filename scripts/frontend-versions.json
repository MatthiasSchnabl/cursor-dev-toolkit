        "package": "@sveltejs/kit",
        "version": "3.0.0"
      },
      "node_min": "22.17.0",
      "minimum_packages": {
        "svelte": "5.57.1",
        "typescript": "6.0.0",
        "vite": "8.0.12",
        "@sveltejs/vite-plugin-svelte": "7.0.0"
      },
      "migration_url": "https://svelte.dev/docs/kit/migrating-to-sveltekit-3",
