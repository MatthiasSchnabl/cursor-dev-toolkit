#!/usr/bin/env bash
# SessionStart: inject a compact, versioned engineering context anchor.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLKIT_ROOT="$(cd "$HOOK_DIR/.." && pwd)"
export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"

TOOLKIT_VERSION="unknown"
if [[ -f "$TOOLKIT_ROOT/versions.env" ]]; then
  # shellcheck disable=SC1090
  source "$TOOLKIT_ROOT/versions.env"
fi

revision="unknown"
if git -C "$TOOLKIT_ROOT" rev-parse HEAD >/dev/null 2>&1; then
  revision="$(git -C "$TOOLKIT_ROOT" rev-parse --short=12 HEAD)"
elif [[ -f "$TOOLKIT_ROOT/.cursor-toolkit-install" ]]; then
  revision="$(sed -n '2p' "$TOOLKIT_ROOT/.cursor-toolkit-install" | tr -d '\r' | cut -c1-12)"
fi

missing=()
for cmd in bun graphify gbrain; do
  command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
done

stale=""
if [[ -f "$TOOLKIT_ROOT/.cursor-toolkit-install" ]]; then
  source_root="$(sed -n '1p' "$TOOLKIT_ROOT/.cursor-toolkit-install" | tr -d '\r')"
  installed_commit="$(sed -n '2p' "$TOOLKIT_ROOT/.cursor-toolkit-install" | tr -d '\r')"
  if command -v cygpath >/dev/null 2>&1 && [[ "$source_root" =~ ^[A-Za-z]:\\ ]]; then
    source_root="$(cygpath -u "$source_root")"
  fi
  if [[ -d "$source_root/.git" ]]; then
    current_source="$(git -C "$source_root" rev-parse HEAD 2>/dev/null || true)"
    if [[ -n "$current_source" && -n "$installed_commit" && "$current_source" != "$installed_commit" ]]; then
      stale="WARNING: installed plugin copy is stale versus source checkout. Rerun install.ps1/install.sh, then reload Cursor."
    fi
  fi
fi

duty="cursor-dev-toolkit engineering context v2
Installed toolkit: version ${TOOLKIT_VERSION:-unknown}, revision $revision.

For non-trivial Plan/Agent work:
- GBrain first for prior project decisions; Graphify for structural/change-impact analysis.
- Follow the matching Superpowers method and use Context7 for current library/API behavior.
- Compact engineering rules are auto-attached anchors. For a material domain change, read the relevant canonical standard via its Contents map before editing.
- Canonical standards live under skills/engineering/_standards/, except the Rust standard at skills/engineering/rust-engineering/references/rust-engineering-standard.md.
- Audit and fix are separate: audit -> ledger -> fix -> verification -> resolved. A fix never invents findings or reuses a resolved audit.
- If plugin/rules/skills seem missing or stale, run /engineering-context-doctor or scripts/verify.sh.

Do not preload all engineering standards. Load only sections relevant to the current phase."

if [[ ${#missing[@]} -gt 0 ]]; then
  duty+=$'\n'"cursor-dev-toolkit: missing on PATH: ${missing[*]}. Run /tooling-setup or scripts/bootstrap.sh."
fi
if [[ -n "$stale" ]]; then
  duty+=$'\n'"$stale"
fi

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

root_escaped="$(escape_for_json "$TOOLKIT_ROOT")"
version_escaped="$(escape_for_json "${TOOLKIT_VERSION:-unknown}")"
duty_escaped="$(escape_for_json "$duty")"
printf '{"env":{"CURSOR_DEV_TOOLKIT_ROOT":"%s","CURSOR_DEV_TOOLKIT_VERSION":"%s"},"additional_context":"%s"}\n' "$root_escaped" "$version_escaped" "$duty_escaped"
